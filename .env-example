# 環境: development / staging / production
COMPOSE_PROFILE=production

# データ保存先ディレクトリ
DATA_DIR=/path/to/_glatasks_data

# パスキー: 本番では実際にアクセスするHTTPSのホスト名とoriginへ設定する
# 開発用の例。未設定の本番環境ではパスキー操作を開始せず、パスワードを使う
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=https://localhost:38180

# セッションCookie名（省略時は __Host-gla-session）
# 既存の名前のCookieでログイン済みの端末を再ログインさせずに運用する場合は、その名前を指定する
# SESSION_COOKIE_NAME=gla-session

# 実行ユーザーの UID と GID
UID=1000
GID=1000
